<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FAF5FF"
    >

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pengaturan Printer"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#4A2B66"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"/>

    <ImageView
        android:id="@+id/imgPrinterState"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/printer"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvStatusPrinter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Tidak Diketahui"
        android:textSize="16sp"
        android:textColor="#8E74A6"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnectPrinter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Hubungkan Printer Bluetooth"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#BA68C8"
        app:cornerRadius="16dp"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrintTest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Cetak Halaman Test"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#66BB6A"
        app:cornerRadius="16dp"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Kembali"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4A2B66"
        app:backgroundTint="#EAD9F7"
        app:cornerRadius="16dp"/>

</LinearLayout>