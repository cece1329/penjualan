<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundFormColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/produk_form_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:textColor="@color/textColorPrimary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produk_name_label"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="@string/produk_name_hint"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produk_price_label"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inHargaProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="@string/produk_price_hint"
            android:inputType="number"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harga Beli / Modal (Opsional)"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inHargaBeli"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Masukkan harga beli/modal..."
            android:inputType="number"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produk_stock_label"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inStokProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="@string/produk_stock_hint"
            android:inputType="number"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produk_branch_label"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPilihCabangProduk"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Cabang (Bisa Banyak)"
            app:icon="@drawable/branch" />

        <TextView
            android:id="@+id/tvSelectedCabangProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Belum ada cabang terpilih"
            android:background="@drawable/bg_border"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produk_category_label"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerKategoriProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/spinner_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produk_status_label"
            android:textColor="@color/textColorPrimary"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_active"
            android:textColor="#4CAF50"
            app:chipBackgroundColor="#E8F5E9"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="#4CAF50"
            android:layout_marginTop="8dp"
            app:chipIconEnabled="true"
            app:chipIcon="@drawable/labeltick"
            app:chipIconTint="#4CAF50"/>

        <Button
            android:id="@+id/btnSimpanProduk"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/produk_save_btn"
            android:backgroundTint="@color/colorSoftPurple"
            android:layout_marginTop="40dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="18dp"
            app:elevation="4dp"/>

        <Button
            android:id="@+id/btnHapusProduk"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="@string/produk_delete_btn"
            android:backgroundTint="#FFEBEE"
            android:textColor="#C62828"
            android:textAllCaps="false"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>