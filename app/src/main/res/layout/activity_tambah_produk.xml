<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundFormColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Produk"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:textColor="@color/textColorPrimary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Masukkan nama produk"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harga Jual"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inHargaBeli"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Contoh: 38000"
            android:inputType="number"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jumlah Stok"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inStokProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Contoh: 7"
            android:inputType="number"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Cabang"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerCabangProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/spinner_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Kategori"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerKategoriProduk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/spinner_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status Produk:"
            android:textColor="@color/textColorPrimary"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktif"
            android:textColor="#4CAF50"
            app:chipBackgroundColor="#E8F5E9"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="#4CAF50"
            android:layout_marginTop="8dp"
            app:chipIconEnabled="true"
            app:chipIcon="@drawable/labeltick"
            app:chipIconTint="#4CAF50"/>

        <Button
            android:id="@+id/btnSimpanProduk"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Simpan Data Produk"
            android:backgroundTint="@color/colorSoftPurple"
            android:layout_marginTop="40dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="18dp"
            app:elevation="4dp"/>

    </LinearLayout>
</ScrollView>