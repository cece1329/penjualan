<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Produk"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:textColor="#2E2E2E"/>

        <LinearLayout
            android:id="@+id/boxFoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_upload_foto"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgFotoProduk"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_camera_placeholder"
                android:alpha="0.5" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambah Foto Produk"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/inNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nama Produk"
            android:background="@drawable/bg_border"
            android:layout_marginTop="24dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"/>

        <EditText
            android:id="@+id/inHargaBeli"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Harga Jual"
            android:inputType="number"
            android:background="@drawable/bg_border"
            android:layout_marginTop="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <Button
            android:id="@+id/btnSimpanProduk"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Simpan"
            android:backgroundTint="#673AB7"
            android:layout_marginTop="30dp"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>