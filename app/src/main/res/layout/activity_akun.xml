<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundFormColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Profile Pic Mock -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_upload_foto">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/acc"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Pemilik"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNamaPemilik"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Contoh: Citra"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Bisnis / Toko"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNamaToko"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Contoh: Citra Mart"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Kontak"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etEmailToko"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Contoh: citra@toko.com"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:inputType="textEmailAddress"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="32dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSimpanProfil"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Simpan Profil Toko"
            android:backgroundTint="#673AB7"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"/>

    </LinearLayout>
</ScrollView>
