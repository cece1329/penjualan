<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_cabang"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/cardBackground"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_image"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivCabangIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/colorSoftPurpleLight"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/labelbranch"
                    app:tint="@color/colorSoftPurple" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvNamaCabang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Nama Cabang"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_image"
            app:layout_constraintTop_toTopOf="@id/card_image" />

        <!-- Info Kota -->
        <LinearLayout
            android:id="@+id/ll_info_kota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/tvNamaCabang"
            app:layout_constraintTop_toBottomOf="@id/tvNamaCabang">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/location"
                app:tint="@color/textColorSecondary" />

            <TextView
                android:id="@+id/tvKotaCabang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Kota"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Info Alamat -->
        <LinearLayout
            android:id="@+id/ll_info_alamat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNamaCabang"
            app:layout_constraintTop_toBottomOf="@id/ll_info_kota">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/location"
                app:tint="@color/textColorSecondary" />

            <TextView
                android:id="@+id/tvAlamatCabang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Alamat Cabang"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Section Pegawai Otomatis -->
        <LinearLayout
            android:id="@+id/lnPegawaiSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNamaCabang"
            app:layout_constraintTop_toBottomOf="@id/ll_info_alamat">

            <ImageView
                android:id="@+id/ivIconPegawai"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/employee"
                app:tint="@color/colorSoftPurple" />

            <TextView
                android:id="@+id/tvDaftarPegawai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Memuat petugas..."
                android:textColor="@color/colorSoftPurple"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>