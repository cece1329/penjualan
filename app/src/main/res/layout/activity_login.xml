<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundFormColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/acc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_app_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/textColorTitle"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_app_subtitle"
            android:textSize="14sp"
            android:textColor="@color/textColorSecondary"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- Role Selector Toggle Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_border"
            android:padding="4dp"
            android:layout_marginBottom="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTabPemilik"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/login_tab_owner"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_simpan"
                android:backgroundTint="@color/colorSoftPurple"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTabKaryawan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/login_tab_employee"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/colorSoftPurple"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <!-- Login Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/cardBackground"
            app:strokeWidth="0dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header Role Text -->
                <TextView
                    android:id="@+id/tvRoleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_as_owner"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/textColorPrimary"
                    android:layout_marginBottom="20dp"/>

                <!-- Username / Phone Label -->
                <TextView
                    android:id="@+id/tvUsernameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_username_owner"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <!-- Username / Phone Input -->
                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/login_hint_owner"
                    android:background="@drawable/bg_border"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:textColor="@color/textColorEditText"
                    android:textColorHint="@color/textColorSecondary"
                    android:layout_marginBottom="16dp"/>

                <!-- Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_password_label"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <!-- Password Input -->
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/login_hint_password"
                    android:background="@drawable/bg_border"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:textColor="@color/textColorEditText"
                    android:textColorHint="@color/textColorSecondary"
                    android:layout_marginBottom="12dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/login_button"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_simpan"
            android:backgroundTint="@color/colorSoftPurple"
            app:cornerRadius="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_copyright"
            android:textColor="@color/textColorSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
