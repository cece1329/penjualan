<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundFormColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cabang_form_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:textColor="@color/textColorPrimary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cabang_name_label"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNamaCabang"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="@string/cabang_name_hint"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wilayah / Kota"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etKotaCabang"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="@string/cabang_city_hint"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cabang_address_label"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etAlamatCabang"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="@string/cabang_address_hint"
            android:background="@drawable/bg_border"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textSize="15sp"
            android:textColor="@color/textColorEditText"
            android:textColorHint="@color/textColorSecondary"
            android:layout_marginBottom="32dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSimpanCabang"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Simpan Cabang"
            android:backgroundTint="@color/colorSoftPurple"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="18dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHapusCabang"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_delete"
            android:backgroundTint="#FFEBEE"
            android:textColor="#C62828"
            android:textAllCaps="false"
            android:visibility="gone"
            app:cornerRadius="18dp"/>

    </LinearLayout>
</ScrollView>
