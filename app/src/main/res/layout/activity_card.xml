<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/settings"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnSettings"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:text="@string/home_welcome_fallback"
                android:textColor="@color/textColorTitle"
                android:textSize="22sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvWorkInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:text="08 Januari 2026"
            android:textColor="@color/textColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_border"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:id="@+id/rowEstimasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_estimasi_hari_ini"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnestimasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Rp 0"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="18sp" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/containerTargetPenjualan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_border"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTargetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_target_penjualan_hari_ini"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:progress="65"
                    android:progressTint="#6200EE" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/tvProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_persen_tercapai"
                        android:textColor="@color/textColorSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTargetAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/home_target"
                        android:textColor="@color/textColorSecondary"
                        android:textSize="12sp" />
                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSetTarget"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/colorSoftPurpleLight"
                    android:text="Atur Target"
                    android:textAllCaps="false"
                    android:textColor="@color/colorSoftPurpleDark"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/btntransaction"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/transaction" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/textColorPrimary"
                        android:text="@string/home_nav_transaction" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/btncust"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/customer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/textColorPrimary"
                        android:text="@string/nav_pelanggan" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerReport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/btnreport"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/report" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/textColorPrimary"
                        android:text="@string/nav_laporan" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/home_siap_melayani_pelanggan"
            android:textColor="@color/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_jangan_kecewakan_pelanggan"
            android:textColor="@color/textColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_border"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnacc"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/acc" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textColorPrimary"
                    android:text="@string/nav_akun" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_border"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnproduct"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/product" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textColorPrimary"
                    android:text="@string/nav_produk" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_border"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnkategori"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/plus" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textColorPrimary"
                    android:text="@string/nav_kategori" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/containerEmployee"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_border"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/employee"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/employee" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textColorPrimary"
                    android:text="@string/nav_pegawai" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerBranch"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_border"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnbranch"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/branch" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textColorPrimary"
                    android:text="@string/nav_cabang" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_border"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnprinter"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/printer" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textColorPrimary"
                    android:text="@string/nav_printer" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
